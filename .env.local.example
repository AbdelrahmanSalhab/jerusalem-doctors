# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Dev-user shim (see plan.md §7 + scripts/seed-dev-doctor.sql) ----
# Set USE_DEV_USER=1 locally to bypass real auth and act as the dev doctor.
# Forbidden in production. Run scripts/seed-dev-doctor.sql then paste the
# returned UUID below.
USE_DEV_USER=
DEV_DOCTOR_ID=

# Set NEXT_PUBLIC_PHONE_AUTH_DISABLED=1 in production until SMS4FREE delivery
# has been tested end to end. Shows a "coming soon" banner on /signup
# and /login.
NEXT_PUBLIC_PHONE_AUTH_DISABLED=

# ---- OTP delivery ----
# Supabase Auth generates, stores, and verifies the code. Our only job is
# delivery, via the Supabase "Send SMS Hook" -> /api/auth/hooks/send-otp.
#
# mock          = log the code to stderr, send nothing (dev only)
# sms4free      = SMS4FREE HTTP API (production)
# whatsapp_meta = direct Meta WhatsApp Cloud API (parked — see below)
OTP_PROVIDER=mock

# Shared secret for the Supabase Send SMS Hook, in the form `v1,whsec_...`.
# Generated in Supabase: Authentication > Hooks > Send SMS hook.
# Required in production — the route fails closed without it.
SEND_SMS_HOOK_SECRET=

# ---- SMS4FREE (production SMS delivery) ----
# Account page: https://sms4free.co.il/  API: /ApiSMS/v2/SendSMS
# SMS4FREE_USER is the phone number the account is registered with.
# SMS4FREE_KEY is revealed only after a code sent to an authorised number.
# SMS4FREE_SENDER: up to 11 Latin letters/digits. Until an SMS package is
# purchased it MUST equal the registration number, and any sender has to be
# verified once by sending a message by hand from the website — otherwise
# every API call comes back -6.
SMS4FREE_KEY=
SMS4FREE_USER=
SMS4FREE_PASS=
SMS4FREE_SENDER=
# Optional endpoint overrides; default to the documented v2 URLs.
SMS4FREE_API_URL=
SMS4FREE_BALANCE_URL=
# Alert when fewer than this many messages remain (default 50). Checked daily
# by /api/cron/sms-balance — the account is prepaid, and an empty balance is a
# silent total outage.
SMS4FREE_LOW_BALANCE_THRESHOLD=

# ---- Meta WhatsApp Cloud API (parked) ----
# Kept wired as a one-variable rollback (OTP_PROVIDER=whatsapp_meta), but
# blocked on Meta Business Verification. See docs/runbook.md.
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_AUTH_TEMPLATE_NAME=otp_login_ar
# Optional: template language, defaults to "ar".
META_AUTH_TEMPLATE_LANG=
# Only needed once a delivery-status webhook is added (deferred).
META_WABA_ID=
META_VERIFY_TOKEN=

# ---- Cloudflare Turnstile (signup/login bot protection) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Upstash Redis (rate limiting) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Israel MoH license registry sync (see plan.md §13) ----
MOH_RESOURCE_ID=9c64c522-bbc2-48fe-96fb-3b2a8626f59e
MOH_API_BASE=https://data.gov.il/api/3
CRON_SECRET=

# ---- Sentry (optional — no-ops without DSN) ----
# Same value can go in both, or set only one. NEXT_PUBLIC_ is for browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
