{
  "name": "jerusalem-doctors",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/rls-smoke-test.ts",
    "test:coverage": "vitest run --coverage",
    "dev-login:list": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/add-dev-login.ts --list",
    "dev-login:add": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/add-dev-login.ts",
    "ci-login:add": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/add-ci-account.ts",
    "e2e:stack": "supabase start && supabase seed buckets && docker compose -f e2e/docker-compose.yml -p jd-e2e up -d",
    "e2e": "playwright test",
    "db:types": "npx -y supabase@2.121.0 gen types typescript --local > lib/db/database.types.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.105.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "libphonenumber-js": "^1.13.15",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
