{
  "name": "jerusalem-doctors",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/rls-smoke-test.ts",
    "test:coverage": "vitest run --coverage",
    "dev-login:list": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/add-dev-login.ts --list",
    "dev-login:add": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/add-dev-login.ts",
    "e2e:stack": "supabase start && supabase seed buckets && docker compose -f e2e/docker-compose.yml -p jd-e2e up -d",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.52.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "libphonenumber-js": "^1.12.43",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
